# =============================================================================
# GenAI Engine — environment template (backend + frontend)
# =============================================================================
# Copy to `.env` at the REPO ROOT:
#   cp .env.example .env        (Unix)
#   copy .env.example .env      (Windows)
#
# • Backend (FastAPI / Docker) reads this file directly.
# • Frontend dev server (`cd frontend && npm run dev`) loads the SAME root
#   `.env` via Vite (`envDir` points to parent). Only variables prefixed with
#   `VITE_` are exposed to the browser; see "FRONTEND (Vite)" below.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=GenAI Engine
# development | production  (production refuses to start with unsafe settings)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS (no spaces around commas).
CORS_ORIGINS=http://localhost:3000

# Rate limiting (Redis sliding window)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Google Gemini (required for chat + embeddings)
# ─────────────────────────────────────────────────────────────────────────────
# https://aistudio.google.com
GEMINI_API_KEY=AIza_your_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7

# Embeddings model id (Gemini)
# Changing the embedding model changes vector dimensions: delete FAISS_INDEX_DIR and re-upload documents.
EMBEDDING_MODEL=models/gemini-embedding-001

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Database & cache
# ─────────────────────────────────────────────────────────────────────────────
# Local dev without Docker (SQLite file under ./data/ — no Postgres install)
DATABASE_URL=sqlite+aiosqlite:///./data/genai_engine.db
# Postgres (must use +asyncpg):
# DATABASE_URL=postgresql+asyncpg://genai_engine:<password>@localhost:5432/genai_engine
# Create/upgrade the schema with:  cd backend && alembic upgrade head

REDIS_URL=redis://localhost:6379/0
# No Redis server required locally — uses in-memory fakeredis
USE_FAKE_REDIS=true

# ─────────────────────────────────────────────────────────────────────────────
# DOCKER COMPOSE
# ─────────────────────────────────────────────────────────────────────────────
# docker-compose.yml sets DATABASE_URL, REDIS_URL, USE_FAKE_REDIS=false and
# ENVIRONMENT=production inside the backend container; the values above are
# for running the backend directly on your machine.
#
# Required for Docker. Use letters and digits only (it is embedded in a URL).
POSTGRES_PASSWORD=change_me_to_a_long_random_value
# Host port for the web UI
HTTP_PORT=3000
# Gunicorn worker processes for the API
WEB_CONCURRENCY=2

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Authentication (JWT)
# ─────────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32   OR   make key   (production requires >= 32 chars)
JWT_SECRET_KEY=your_256_bit_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Voice (optional cloud TTS; STT is optional `faster-whisper` — see requirements-voice.txt)
# ─────────────────────────────────────────────────────────────────────────────
WHISPER_MODEL=base.en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — RAG / vector store
# ─────────────────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_RAG_RESULTS=8
FAISS_INDEX_DIR=./data/faiss

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Agent tools (sandbox)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated hostname allowlist for the `api_call` tool (no https:// prefix)
ALLOWED_API_DOMAINS=api.github.com,httpbin.org,api.openweathermap.org

# Per-user workspace root for `file_read` / `file_write`
WORKSPACE_DIR=./data/workspace

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND — Vite (dev server + optional client overrides)
# ─────────────────────────────────────────────────────────────────────────────
# Browser-exposed: must stay prefixed with VITE_
#
# Dev proxy: where to forward `/api` when using `npm run dev`
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Dev server port (default 3000 if unset)
VITE_DEV_PORT=3000

# Optional: full origin of the API for the browser (no trailing slash).
# Leave EMPTY to use relative URLs `/api/v1` — correct when:
#   • Vite dev proxy handles /api, OR
#   • Production Nginx serves SPA and proxies /api to the backend.
# Set only if the UI and API are on different origins without a proxy, e.g.:
#   VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
