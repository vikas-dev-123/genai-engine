# =============================================================================
# Jarvis AI — environment template (backend + frontend)
# =============================================================================
# Copy to `.env` at the REPO ROOT:
#   cp .env.example .env        (Unix)
#   copy .env.example .env      (Windows)
#
# • Backend (FastAPI / Docker) reads this file directly.
# • Frontend dev server (`cd frontend && npm run dev`) loads the SAME root
#   `.env` via Vite (`envDir` points to parent). Only variables prefixed with
#   `VITE_` are exposed to the browser; see "FRONTEND (Vite)" below.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=Jarvis AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS (no spaces around commas).
CORS_ORIGINS=http://localhost:3000

# Rate limiting (Redis sliding window)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Google Gemini (required for chat + embeddings)
# ─────────────────────────────────────────────────────────────────────────────
# https://aistudio.google.com
GEMINI_API_KEY=AIza_your_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7

# Embeddings model id (Gemini)
EMBEDDING_MODEL=models/text-embedding-004

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Database & cache
# ─────────────────────────────────────────────────────────────────────────────
# Local / host Postgres (must use +asyncpg for this codebase)
DATABASE_URL=postgresql+asyncpg://jarvis:password@localhost:5432/jarvis

REDIS_URL=redis://localhost:6379/0

# Note: `docker-compose.yml` overrides DATABASE_URL and REDIS_URL inside the
# `backend` container to point at the `postgres` and `redis` services.

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Authentication (JWT)
# ─────────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32   OR   make key
JWT_SECRET_KEY=your_256_bit_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Voice (optional cloud TTS; STT is local faster-whisper)
# ─────────────────────────────────────────────────────────────────────────────
WHISPER_MODEL=base.en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — RAG / vector store
# ─────────────────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_RAG_RESULTS=8
FAISS_INDEX_DIR=./data/faiss

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Agent tools (sandbox)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated hostname allowlist for the `api_call` tool (no https:// prefix)
ALLOWED_API_DOMAINS=api.github.com,httpbin.org,api.openweathermap.org

# Per-user workspace root for `file_read` / `file_write`
WORKSPACE_DIR=./data/workspace

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND — Vite (dev server + optional client overrides)
# ─────────────────────────────────────────────────────────────────────────────
# Browser-exposed: must stay prefixed with VITE_
#
# Dev proxy: where to forward `/api` when using `npm run dev`
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Dev server port (default 3000 if unset)
VITE_DEV_PORT=3000

# Optional: full origin of the API for the browser (no trailing slash).
# Leave EMPTY to use relative URLs `/api/v1` — correct when:
#   • Vite dev proxy handles /api, OR
#   • Production Nginx serves SPA and proxies /api to the backend.
# Set only if the UI and API are on different origins without a proxy, e.g.:
#   VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
